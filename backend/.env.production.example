# Staging/production environment template (NOV-38).
#
# .env.example is shaped for local development only (SQLite, APP_DEBUG=true,
# log-based mail/broadcast) - see docs/ARCHITECTURE_AUDIT.md finding H1 for
# why that divergence from the real MySQL-based financial logic matters.
# This file is the non-local shape: copy it to .env on a staging or
# production host and fill in every <CHANGE_ME> placeholder. Staging and
# production use this same template - the only difference between them is
# the actual values (a staging domain/database vs. a production one), not
# the shape of the config.
#
# Never commit a real filled-in .env file. This template intentionally
# contains no real secrets.

APP_NAME=Novapay
APP_ENV=production
# Generate a fresh key per environment with `php artisan key:generate` -
# never copy an APP_KEY between environments or in from local development.
APP_KEY=
# Must be false outside local development - debug mode exposes stack
# traces, environment variables, and query bindings in error responses.
APP_DEBUG=false
APP_URL=https://<CHANGE_ME:your-domain>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# 'debug' is too verbose for a real environment - NOV-42 confirmed no
# sensitive data reaches the logs at any level, but debug-level Laravel
# framework logging is still noisier than a production host needs.
LOG_LEVEL=info

# MySQL, matching what the test suite and CI already run against (and what
# the idempotency/CHECK-constraint logic in the migrations assumes) - not
# SQLite. See docs/DATABASE_SCHEMA.md for the full schema this connects to.
DB_CONNECTION=mysql
DB_HOST=<CHANGE_ME>
DB_PORT=3306
DB_DATABASE=<CHANGE_ME>
DB_USERNAME=<CHANGE_ME>
DB_PASSWORD=<CHANGE_ME>

SESSION_DRIVER=database
SESSION_LIFETIME=120
# true outside local development - cookies should not travel over plain HTTP.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=<CHANGE_ME:.your-domain.com or leave null for a single host>

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# NOT YET DECIDED - NOV-24 ("Decide production queue driver") is still an
# open task. `database` is what local dev/CI use today; SendPushNotificationJob
# relies on a worker process actually running (`php artisan queue:work`) -
# see NOV-39 ("Confirm queue-worker deploy story"), also still open. Do not
# treat this value as a final production decision - it is today's default,
# carried forward, not a recommendation.
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
# This app has no email-sending feature today (no forgot-password route
# exists - see docs/API_SPECIFICATION.md). Leave as `log` unless/until a
# real transactional email need is added; don't configure a real SMTP
# provider speculatively.

# Only fill these in if a real file-storage need (e.g. KYC document
# upload) is actually added - nothing in the app uses S3 today.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Absolute path to the Firebase service-account JSON on this host - see
# docs/FIREBASE_CONFIGURATION.md. Never commit the actual key file.
FIREBASE_CREDENTIALS=<CHANGE_ME:/absolute/path/to/service-account.json>
